<?xml version="1.0" encoding="UTF-8"?>
<!--
  Entitlements for the main app.

  com.apple.developer.family-controls is the Screen Time / Family Controls
  entitlement that permits shielding other apps. It is a RESTRICTED entitlement:
  Apple grants it only on a written request at
  https://developer.apple.com/contact/request/family-controls-distribution ,
  and approval takes weeks and can be refused. The value below is what a
  granted profile enables; it does nothing until Apple attaches it to your
  provisioning profile.

  Without this entitlement the app still builds and runs — app blocking simply
  reports itself unavailable (see BlockingManager.isAuthorized), and every
  other feature works. That degradation is deliberate so the app can ship to
  TestFlight while the entitlement request is pending.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.family-controls</key>
	<true/>
	<!--
	  A shared App Group so the main app, the DeviceActivityMonitor extension
	  and the ShieldConfiguration extension can share the selected-app tokens
	  and the current lock state. All three run in separate processes and can
	  only communicate through this shared container.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.prayerlock.shared</string>
	</array>
</dict>
</plist>
