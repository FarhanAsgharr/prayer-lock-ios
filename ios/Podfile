# Uncomment this line to define a global platform for your project
# The Screen Time frameworks (FamilyControls, ManagedSettings, DeviceActivity)
# need iOS 13 as the app floor, but are only *used* on iOS 16+ behind runtime
# availability checks. Setting the platform to 13.0 keeps the widest device
# support while still allowing the 16.0 extensions to build.
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# The three Screen Time extensions have no Flutter or CocoaPods dependencies —
# they use only Apple's system frameworks (declared in the project, not here).
# They are listed so CocoaPods is aware of them and does not warn, and so their
# base configuration inherits the project's build settings cleanly.
target 'DeviceActivityMonitor' do
  use_frameworks!
end

target 'ShieldConfiguration' do
  use_frameworks!
end

target 'ShieldAction' do
  use_frameworks!
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # Match the app's deployment floor across all pods so CocoaPods does not
      # emit dozens of "deployment target lower than…" warnings, and so pods do
      # not accidentally require a newer minimum than the app supports.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'

      # Required for some plugins (permission_handler) that gate features behind
      # compile-time macros. These enable exactly the permissions this app uses
      # and disable the rest, which keeps App Review from flagging unused
      # permission prompts.
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_LOCATION=1',
        'PERMISSION_NOTIFICATIONS=1',
      ]
    end
  end
end
